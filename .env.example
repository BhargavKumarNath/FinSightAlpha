# FinSightAlpha environment configuration.
# Copy this file to .env and fill in real values. See README.md section 9.1.

# Required. Groq API key used for LLM inference (llama-3.3-70b-versatile,
# llama-3.1-8b-instant). The backend raises an error at startup if this is
# missing. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. HuggingFace Hub token, only needed for gated or private models.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional. Override any OptimizationConfig field by setting
# FINSIGHT_OPT_<FIELD_NAME> in upper case. See src/optimization/config.py
# for the full list of fields and their defaults. Examples:
# FINSIGHT_OPT_SESSION_TOKEN_BUDGET=100000
# FINSIGHT_OPT_CACHE_SIMILARITY_THRESHOLD=0.92
